    <!-- Setup -->
    <string name="setup_title">Permissions &amp; Setup</string>
    <string name="setup_intro">SleepOff needs a few permissions to work reliably overnight. Each one has a clear purpose — nothing is requested without a reason.</string>
    <string name="setup_bt_connect">Bluetooth connection</string>
    <string name="setup_bt_connect_desc">Shows the name of your connected headphones or speaker. Android 12+ requires this to read connected devices.</string>
    <string name="setup_notifications">Notifications</string>
    <string name="setup_notifications_desc">Shows the countdown and the completion message. Required on Android 13+.</string>
    <string name="setup_exact_alarm">Exact alarm</string>
    <string name="setup_exact_alarm_desc">Fires the timer at the exact time, even while the phone is in Doze (deep sleep).</string>
    <string name="setup_battery">Battery optimization exemption</string>
    <string name="setup_battery_desc">Prevents the system from killing SleepOff overnight. Strongly recommended.</string>
    <string name="setup_listener">Media session access (optional)</string>
    <string name="setup_listener_desc">Optional. Grants access to the active media session for a more reliable pause. The standard media-key pause works without it.</string>
    <string name="setup_accessibility">Bluetooth auto-toggle helper (optional)</string>
    <string name="setup_accessibility_desc">Optional. On Android 13+, only this kind of user-authorized automation can turn Bluetooth off for you. SleepOff never hides this limitation.</string>
    <string name="setup_bt_note_title">About Bluetooth on Android 13+</string>
    <string name="setup_bt_note_body">Since Android 13 (API 33), Google removed the ability for third-party apps to turn Bluetooth off directly (BluetoothAdapter.disable() is deprecated and requires a system-only permission). SleepOff handles this honestly:\n\n• On Android 12 and older, Bluetooth is switched off directly when permitted.\n• On Android 13+, SleepOff pauses your music, then shows a notification with a one-tap shortcut to Bluetooth settings — or, if you enable the optional helper above, taps the toggle for you.\n• SleepOff always reports what actually happened. It never claims Bluetooth is off when it is not.</string>

